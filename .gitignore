# Les depots clones sont recuperables depuis tools/repos.tsv : les suivre ici
# ferait de ce depot un miroir de trente autres.
/repos/

# Les donnees se comptent en dizaines a centaines de gigaoctets (77 Go pour la
# seule region grand-prize en Zarr, 390 Go en pile TIFF). Elles se retelechargent
# par fenetre, pour une question precise.
/data/

# Le miroir du site est reproductible par wget ; ce qui merite d'etre suivi, ce
# sont les notes qu'on en tire, pas les 100+ Mo d'assets.
/site/

# Logs de recuperation : utiles pendant un run, sans valeur apres.
/docs/*.log
/docs/*.pid

__pycache__/
*.pyc
.venv/

# Environnement de l'experience : reconstructible par `uv sync`.
/experiments/.venv/
/experiments/uv.lock

# Sous-produits du controle de miroir : regeneres a chaque passe.
/docs/sitemap.xml
/docs/sitemap_paths.txt

# Cartes d encre et images produites : regenerables par inference_xpu/src/infer_ink.py
/data/out/
/inference/.venv/
/inference/uv.lock
/inference_xpu/.venv/
/inference_xpu/uv.lock

# Les figures des documents sont suivies : elles portent des resultats mesures.
!/docs/images/
.env

# ⚠ Note privee de session : contexte que l'auteur ne veut pas voir partir avec le
# depot. Le fichier existe, son contenu ne se versionne pas.
/PRIVE.md
data/trace/*/render_a/
data/trace/*/cache_vol/
.lances/
article/pg-*.png
