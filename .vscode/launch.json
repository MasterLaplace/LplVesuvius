{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "vesuve: the Python test under the cursor",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "${file}"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "preLaunchTask": "vesuve: build the core (debug)",
      "justMyCode": false
    },
    {
      "name": "vesuve: the C test under the cursor",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/tests/${fileBasenameNoExtension}",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "vesuve: build the C tests",
      "environment": [{ "name": "ASAN_OPTIONS", "value": "detect_leaks=0" }]
    },
    {
      "name": "vesuve: the program (formulas)",
      "type": "debugpy",
      "request": "launch",
      "module": "vesuve.cli",
      "args": ["formulas"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "preLaunchTask": "vesuve: build the core (debug)",
      "justMyCode": false
    }
  ]
}
